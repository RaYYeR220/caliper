# --- secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
# Anchored to the root. Unanchored, this swallowed `trajectories/build/` — three files the
# README links to and the challenge requires — and the repository looked complete locally.
/build/

# --- node / web ---
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# --- working artifacts that must never be published ---
internal/
*-internal/
scratch/
notes-*.md
ui-prototypes/
mockups/
design-ref/
variants/
video/
*.mp4
*.mov
*.bundle
*-backup*
# The terminology store is committed, not ignored: the resolver reads it before it calls a
# model, so a cold store makes a replay resolve differently from the run it replays. Everything
# else this directory holds is scratch.
.caliper/*
!.caliper/concepts.json

# --- large or regenerable data ---
data/patients/raw/
.cache/
runs/*/raw/

# --- os ---
.DS_Store
Thumbs.db
