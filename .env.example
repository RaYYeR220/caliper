# Copy to .env. Nothing here is needed to reproduce the headline result — that runs from recorded
# responses. A key is only required to re-record them or to run the live evaluation.

# Which provider and model the agents talk to.
CALIPER_PROVIDER=venice
CALIPER_MODEL=claude-sonnet-5

# https://venice.ai — OpenAI-compatible.
VENICE_API_KEY=

# An alternative provider. `CALIPER_PROVIDER=openrouter` routes every agent through it, which is
# how you would check that the design does not depend on one vendor's structured-output support.
# No arm of the committed evaluation uses it: that comparison was never run, and `EVIDENCE.md`
# lists it under what is not claimed rather than implying a result we do not have.
OPENROUTER_API_KEY=

# The date every screening is evaluated as of. Fixed so results are comparable across runs.
CALIPER_SCREENING_DATE=2026-06-01
